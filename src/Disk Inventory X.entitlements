<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Entitlements of the Developer ID build made by BuildRelease.sh. None are needed. The file once held
	  com.apple.security.cs.disable-library-validation for an embedded
	  TreeMapView.framework; the treemap is compiled into the app now and nothing
	  but system frameworks is loaded, so a hardened-runtime build runs without it
	  (checked with an ad-hoc signed build).
	-->
</dict>
</plist>
